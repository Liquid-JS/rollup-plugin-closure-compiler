{
    "name": "@liquid-js/rollup-plugin-closure-compiler",
    "version": "0.28.3",
    "description": "Rollup + Google Closure Compiler",
    "type": "module",
    "main": "./lib/index.mjs",
    "types": "./lib/index.d.ts",
    "exports": {
        "./package.json": {
            "default": "./package.json"
        },
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.mjs"
        }
    },
    "files": [
        "lib"
    ],
    "peerDependencies": {
        "google-closure-compiler": ">=20250820.0.0",
        "rollup": ">=4.50"
    },
    "dependencies": {
        "@ampproject/remapping": "^2.3.0",
        "acorn": "^8.19.0",
        "acorn-walk": "^8.3.5",
        "estree-walker": "^3.0.3",
        "magic-string": "^1.4.5"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@rollup/plugin-typescript": "^12.3.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/estree": "^1.0.10",
        "@types/google-closure-compiler": "^20231112.0.0",
        "@types/node": "<27.0.0",
        "ava": "^8.3.0",
        "builtins": "^6.1.0",
        "c8": "^12.0.0",
        "clean-package": "^2.2.0",
        "codecov": "^3.8.3",
        "commit-and-tag-version": "<13.1.0",
        "cross-env": "^10.1.0",
        "eslint": "^10.14.0",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-jsdoc": "^65.4.4",
        "eslint-plugin-prefer-arrow-functions": "^3.10.2",
        "eslint-plugin-unused-imports": "^4.4.1",
        "google-closure-compiler": "20250820.0.0",
        "husky": "^9.1.7",
        "npm-check-updates": "^23.1.1",
        "rimraf": "^6.1.4",
        "rollup": "^4.67.5",
        "tslib": "^2.9.1",
        "tsx": "^4.23.15",
        "typedoc": "^0.28.20",
        "typescript": "<7.0.0",
        "typescript-eslint": "^8.72.1"
    },
    "scripts": {
        "build": "rimraf lib && rollup -c rollup.config.ts",
        "test": "ava -s",
        "coverage": "c8 ava -s && c8 report --reporter=html",
        "lint": "eslint . --fix",
        "prepublishOnly": "npm run build",
        "prepare": "husky",
        "release": "git diff --exit-code && commit-and-tag-version && git push --follow-tags origin",
        "docs": "typedoc",
        "prepack": "clean-package",
        "postpack": "clean-package restore"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Liquid-JS/rollup-plugin-closure-compiler.git"
    },
    "keywords": [
        "rollup-plugin"
    ],
    "author": "HitkoDev <development@hitko.si>",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/Liquid-JS/rollup-plugin-closure-compiler/issues"
    },
    "homepage": "https://liquid-js.github.io/rollup-plugin-closure-compiler/",
    "packageManager": "yarn@4.18.1",
    "clean-package": {
        "remove": [
            "packageManager",
            "scripts",
            "devDependencies",
            "clean-package",
            "publishConfig"
        ]
    }
}
